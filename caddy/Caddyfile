# Caddyfile — HTTPS reverse proxy for the FYP Supervision System.
#
# Local dev with the bundled internal CA (no DNS / no Let's Encrypt):
#   app.localhost  ->  frontend nginx (container :80)
#   api.localhost  ->  backend spring  (container :8080)
#
# Modern Chrome / Firefox auto-resolve *.localhost to 127.0.0.1 (RFC 6761).
# Trust Caddy's local root once:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml exec caddy \
#     caddy trust
#
# Production: set the env vars below (droplet .env → compose caddy service)
# instead of editing this file — local edits get wiped by git pull:
#   APP_DOMAIN=app.example.com   API_DOMAIN=api.example.com
#   API_ORIGIN=https://api.example.com
#   CADDY_TLS_MODE=<your-email>   (an email arg = Let's Encrypt ACME;
#                                  the default `internal` = local CA)
#   ACME_EMAIL=<your-email>

{
	# Disable the admin endpoint that ships open by default — we don't need
	# the runtime API and exposing it on a public host is needless surface.
	admin off
	# Email used for Let's Encrypt account when you switch to public certs.
	# Harmless with `tls internal`.
	email {$ACME_EMAIL:admin@example.com}
}

# ---------- Frontend (Vite-built SPA served by nginx) -----------------------
{$APP_DOMAIN:app.localhost} {
	tls {$CADDY_TLS_MODE:internal}

	encode zstd gzip

	# Standard hardening — most are HTTPS-only so they belong on the proxy.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# CSP. Tight on scripts (no 'unsafe-inline' — the theme bootstrap lives
		# at /theme-bootstrap.js to satisfy 'self'). Permissive on styles because
		# React inline style={} attrs and some Tailwind utilities use them.
		# The API origin comes from $API_ORIGIN (set alongside APP_DOMAIN).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: {$API_ORIGIN:https://api.localhost}; connect-src 'self' {$API_ORIGIN:https://api.localhost}; manifest-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
		-Server
	}

	reverse_proxy frontend:80

	log {
		output stdout
		format console
	}
}

# ---------- Backend API (Spring Boot) ---------------------------------------
{$API_DOMAIN:api.localhost} {
	tls {$CADDY_TLS_MODE:internal}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Pass the original host/scheme so Spring can build correct redirect URLs
	# and email links (APP_BASE_URL).
	reverse_proxy backend:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format console
	}
}
