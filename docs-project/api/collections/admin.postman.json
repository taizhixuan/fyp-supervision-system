{
  "info": {
    "_postman_id": "fyp-admin-collection-2026",
    "name": "FYP Supervision - Admin",
    "description": "Admin endpoints. Login as admin@mmu.edu.my / Admin@123 to populate {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard"] } }
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users?role=&status=&search=",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "role", "value": "STUDENT", "disabled": true },
                { "key": "status", "value": "ACTIVE", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get User",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/admin/users/:id", "host": ["{{baseUrl}}"], "path": ["admin", "users", ":id"], "variable": [{ "key": "id", "value": "1" }] } }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"SUPERVISOR\",\n  \"fullName\": \"Dr. New Supervisor\",\n  \"mmuId\": \"2001000099\",\n  \"email\": \"new.supervisor@mmu.edu.my\",\n  \"phone\": \"012-9999999\",\n  \"password\": \"Welcome@2026\",\n  \"status\": \"ACTIVE\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Updated Name\",\n  \"phone\": \"019-1234567\",\n  \"status\": \"ACTIVE\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/users/:id", "host": ["{{baseUrl}}"], "path": ["admin", "users", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/users/:id", "host": ["{{baseUrl}}"], "path": ["admin", "users", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Bulk Update Status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userIds\": [3, 4, 5],\n  \"status\": \"SUSPENDED\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/users/bulk-status", "host": ["{{baseUrl}}"], "path": ["admin", "users", "bulk-status"] }
          }
        }
      ]
    },
