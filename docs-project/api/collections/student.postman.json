    {
      "name": "7. Meetings",
      "item": [
        {
          "name": "List Meetings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/student/meetings?status=CONFIRMED&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["student", "meetings"],
              "query": [
                { "key": "status", "value": "CONFIRMED", "disabled": true },
                { "key": "page", "value": "0", "disabled": true },
                { "key": "size", "value": "20", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Meeting",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/student/meetings/:id", "host": ["{{baseUrl}}"], "path": ["student", "meetings", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Request Meeting",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"FYP Progress Discussion - Week 6\",\n  \"agenda\": \"1. Show database design\\n2. Discuss auth implementation\\n3. Plan next sprint\",\n  \"platform\": \"GOOGLE_MEET\",\n  \"location\": \"https://meet.google.com/abc-defg-hij\",\n  \"duration\": 30,\n  \"proposedStartAt\": \"2026-05-07T14:00:00\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/student/meetings", "host": ["{{baseUrl}}"], "path": ["student", "meetings"] }
          }
        },
        {
          "name": "Cancel Meeting",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Conflict with another class\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/student/meetings/:id/cancel", "host": ["{{baseUrl}}"], "path": ["student", "meetings", ":id", "cancel"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
