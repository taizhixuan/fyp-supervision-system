            "url": { "raw": "{{baseUrl}}/student/logs/:id/sign", "host": ["{{baseUrl}}"], "path": ["student", "logs", ":id", "sign"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
