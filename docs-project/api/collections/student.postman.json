          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"summary\": \"Updated summary text\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/student/logs/:id", "host": ["{{baseUrl}}"], "path": ["student", "logs", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Submit Log",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/student/logs/:id/submit", "host": ["{{baseUrl}}"], "path": ["student", "logs", ":id", "submit"], "variable": [{ "key": "id", "value": "1" }] }
