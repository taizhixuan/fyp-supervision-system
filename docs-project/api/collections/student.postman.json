          }
        },
        {
          "name": "Get Supervisor by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/supervisors/2", "host": ["{{baseUrl}}"], "path": ["supervisors", "2"] }
