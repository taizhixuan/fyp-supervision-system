{
  "info": {
    "_postman_id": "fyp-student-collection-2026",
    "name": "FYP Supervision - Student",
    "description": "All 41 student endpoints. Requires STUDENT role token in {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/student/dashboard", "host": ["{{baseUrl}}"], "path": ["student", "dashboard"] }
          }
        }
      ]
    },
    {
      "name": "2. Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/student/profile", "host": ["{{baseUrl}}"], "path": ["student", "profile"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"programme\": \"Bachelor of Computer Science (Hons)\",\n  \"specialisation\": \"Software Engineering\",\n  \"faculty\": \"Faculty of Computing & Informatics\",\n  \"intakeYear\": 2021,\n  \"expectedGraduation\": \"2025-06\",\n  \"cgpa\": 3.50,\n  \"interests\": [\"Artificial Intelligence\", \"Web Development\"],\n  \"skills\": [\"Java\", \"Python\", \"React\"],\n  \"bio\": \"Passionate about AI and full-stack dev.\",\n  \"linkedinUrl\": \"https://linkedin.com/in/username\",\n  \"githubUrl\": \"https://github.com/username\",\n  \"portfolioUrl\": \"https://myportfolio.com\",\n  \"phone\": \"012-3456789\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/student/profile", "host": ["{{baseUrl}}"], "path": ["student", "profile"] }
          }
        },
        {
          "name": "Upload Profile Image",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": { "raw": "{{baseUrl}}/student/profile/image", "host": ["{{baseUrl}}"], "path": ["student", "profile", "image"] }
          }
        }
      ]
    },
