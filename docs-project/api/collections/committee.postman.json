{
  "info": {
    "_postman_id": "fyp-committee-collection-2026",
    "name": "FYP Supervision - Committee",
    "description": "Committee endpoints. Login as ahmad.razak@mmu.edu.my / Test@123 to populate {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/committee/dashboard", "host": ["{{baseUrl}}"], "path": ["committee", "dashboard"] } }
        }
      ]
    },
    {
      "name": "2. Projects",
      "item": [
        {
          "name": "List All Projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/committee/projects?status=&cycle=",
              "host": ["{{baseUrl}}"],
              "path": ["committee", "projects"],
              "query": [
                { "key": "status", "value": "", "disabled": true },
                { "key": "cycle", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Project",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/committee/projects/:id", "host": ["{{baseUrl}}"], "path": ["committee", "projects", ":id"], "variable": [{ "key": "id", "value": "1" }] } }
        },
        {
          "name": "List Unpaired Students",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/committee/projects/unpaired-students", "host": ["{{baseUrl}}"], "path": ["committee", "projects", "unpaired-students"] } }
        },
        {
          "name": "List Supervisor Loads",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/committee/projects/supervisor-loads", "host": ["{{baseUrl}}"], "path": ["committee", "projects", "supervisor-loads"] } }
        },
        {
          "name": "Get Supervisor Load",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/committee/projects/supervisor-loads/:id", "host": ["{{baseUrl}}"], "path": ["committee", "projects", "supervisor-loads", ":id"], "variable": [{ "key": "id", "value": "2" }] } }
        }
      ]
    },
    {
      "name": "3. Proposals",
      "item": [
        {
          "name": "List Proposals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/committee/proposals?status=SUBMITTED",
              "host": ["{{baseUrl}}"],
              "path": ["committee", "proposals"],
              "query": [{ "key": "status", "value": "SUBMITTED", "disabled": true }]
            }
          }
        },
        {
          "name": "Get Proposal",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/committee/proposals/:id", "host": ["{{baseUrl}}"], "path": ["committee", "proposals", ":id"], "variable": [{ "key": "id", "value": "1" }] } }
        },
        {
          "name": "Review Proposal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"APPROVE\",\n  \"comments\": \"Approved by committee. Scope is appropriate.\",\n  \"reviewerId\": 4\n}" },
            "url": { "raw": "{{baseUrl}}/committee/proposals/:id/review", "host": ["{{baseUrl}}"], "path": ["committee", "proposals", ":id", "review"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "4. Documents",
      "item": [
        {
          "name": "List Resource Documents",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/committee/documents", "host": ["{{baseUrl}}"], "path": ["committee", "documents"] } }
        },
        {
          "name": "Get Document",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/committee/documents/:id", "host": ["{{baseUrl}}"], "path": ["committee", "documents", ":id"], "variable": [{ "key": "id", "value": "1" }] } }
        },
        {
          "name": "Upload Document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "title", "type": "text", "value": "FYP Proposal Template 2026" },
                { "key": "description", "type": "text", "value": "Official template for FYP proposals" },
                { "key": "category", "type": "text", "value": "TEMPLATE" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/committee/documents", "host": ["{{baseUrl}}"], "path": ["committee", "documents"] }
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/committee/documents/:id", "host": ["{{baseUrl}}"], "path": ["committee", "documents", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "5. Announcements",
      "item": [
        {
          "name": "List Announcements",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/committee/announcements", "host": ["{{baseUrl}}"], "path": ["committee", "announcements"] } }
        },
        {
          "name": "Create Announcement",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"FYP2 Cycle Started\",\n  \"content\": \"All FYP2 deliverables and deadlines have been published.\",\n  \"audience\": [\"STUDENT\", \"SUPERVISOR\"],\n  \"priority\": \"HIGH\"\n}" },
            "url": { "raw": "{{baseUrl}}/committee/announcements", "host": ["{{baseUrl}}"], "path": ["committee", "announcements"] }
          }
        },
        {
          "name": "Update Announcement",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated\",\n  \"content\": \"Updated content\"\n}" },
            "url": { "raw": "{{baseUrl}}/committee/announcements/:id", "host": ["{{baseUrl}}"], "path": ["committee", "announcements", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Archive Announcement",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/committee/announcements/:id/archive", "host": ["{{baseUrl}}"], "path": ["committee", "announcements", ":id", "archive"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "6. Reports",
      "item": [
        {
          "name": "List Reports",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/committee/reports", "host": ["{{baseUrl}}"], "path": ["committee", "reports"] } }
        },
        {
          "name": "Generate Report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reportType\": \"PROPOSAL_STATUS\",\n  \"cycleId\": 1,\n  \"format\": \"PDF\"\n}" },
            "url": { "raw": "{{baseUrl}}/committee/reports/generate", "host": ["{{baseUrl}}"], "path": ["committee", "reports", "generate"] }
          }
        },
        {
          "name": "Download Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/committee/reports/:id/download", "host": ["{{baseUrl}}"], "path": ["committee", "reports", ":id", "download"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Delete Report",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/committee/reports/:id", "host": ["{{baseUrl}}"], "path": ["committee", "reports", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    }
  ]
}
