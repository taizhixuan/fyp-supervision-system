# =============================================================================
# FYP Supervision System — environment template
# =============================================================================
# Copy to `.env` (gitignored) and fill in real values for local Docker Compose.
# For the prod overlay, prefer Docker secrets (see docker-compose.prod.yml and
# docs-project/concepts/deployment-readiness.md § 11).
# =============================================================================

# -----------------------------------------------------------------------------
# Auth — JWT (REQUIRED in production)
# -----------------------------------------------------------------------------
# MUST be a random ≥32-char string (HS256 = 256-bit key). The backend refuses
# to start with the bundled dev default when SPRING_PROFILES_ACTIVE=prod.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=dev-secret-key-must-be-at-least-32-characters-long-for-hs256
JWT_EXPIRY_MS=86400000

# -----------------------------------------------------------------------------
# Database (only override when pointing at a non-bundled MySQL)
# -----------------------------------------------------------------------------
# DB_URL=jdbc:mysql://db:3306/fyp_supervision
# DB_USER=fyp_user
# DB_PASS=fyp_pass

# -----------------------------------------------------------------------------
# AI services — LLM provider (chatbot answers + proposal feedback text)
# -----------------------------------------------------------------------------
# Everything else (embeddings, DistilBERT scoring, FAISS retrieval) always runs
# locally. The LLM can be local (Ollama) or a cloud API. See llm_provider.py.
# The admin can also switch provider at runtime: Admin > Integration Settings.
#
# LLM_PROVIDER = ollama | groq | openai | custom | none
# Blank = first key found wins (LLM_API_KEY, GROQ_API_KEY, OPENAI_API_KEY), else none.
LLM_PROVIDER=

# Local LLM via Ollama. Start it with: docker compose --profile local-llm up -d
# Pull a model once: docker compose exec ollama ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.2:3b
# Reuse an existing Ollama volume (models already pulled) instead of a fresh one.
OLLAMA_VOLUME=
# Seconds before an LLM call gives up and the service falls back (default 100 local, 45 cloud).
LLM_TIMEOUT=

# Cloud providers. Keys only live here / in secrets, never in the database.
#   GROQ_API_KEY   -> Groq, defaults to openai/gpt-oss-120b  (https://console.groq.com/keys)
#   OPENAI_API_KEY -> OpenAI, defaults to gpt-4o-mini
#   LLM_API_KEY    -> custom endpoint, pair with LLM_BASE_URL and LLM_MODEL
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Shared secret the backend sends to the AI services' LLM admin endpoints.
# Set it in production so the published AI ports can't be used to repoint the LLM.
AI_INTERNAL_TOKEN=

# Embedding model for the recommendation service. Override to all-MiniLM-L6-v2
# for a smaller / faster fallback.
REC_EMBED_MODEL=BAAI/bge-base-en-v1.5

# -----------------------------------------------------------------------------
# Email (SMTP) — optional; APP_EMAIL_ENABLED=false leaves these blank
# -----------------------------------------------------------------------------
APP_EMAIL_ENABLED=false
APP_EMAIL_FROM=fyp-noreply@mmu.edu.my
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Web push notifications (VAPID) — optional
# -----------------------------------------------------------------------------
# Generate a keypair with:  npx web-push generate-vapid-keys
APP_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:fyp-noreply@mmu.edu.my

# -----------------------------------------------------------------------------
# Frontend — build-time API base URL the browser uses to call the backend
# -----------------------------------------------------------------------------
# Local: http://localhost:8080/api
# Caddy prod overlay: https://api.localhost/api (or your real domain)
VITE_API_BASE_URL=http://localhost:8080/api

# -----------------------------------------------------------------------------
# CORS — comma-separated allowed origins for the API
# -----------------------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# -----------------------------------------------------------------------------
# PDPA retention windows (days)
# -----------------------------------------------------------------------------
APP_RETENTION_NOTIFICATION_DAYS=180
APP_RETENTION_CHAT_SESSION_DAYS=180

# -----------------------------------------------------------------------------
# Per-user rate limits (requests / hour)
# -----------------------------------------------------------------------------
APP_RATE_LIMIT_CHAT_PER_HOUR=60
APP_RATE_LIMIT_ANALYZE_PER_HOUR=10

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
TZ=Asia/Kuala_Lumpur
APP_BASE_URL=http://localhost:3000
