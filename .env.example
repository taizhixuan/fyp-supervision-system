# FYP Supervision System - Environment Variables

# JWT Configuration
JWT_SECRET=your-secret-key-must-be-at-least-32-characters-long-for-hs256
JWT_EXPIRY_MS=86400000

# OpenAI API Key (required for AI services)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Frontend (build-time: API base URL the browser will use to call the backend)
# When running via Docker Compose, use http://localhost:8080/api so the browser can reach the backend.
# For local dev (npm run dev), optional; defaults to http://localhost:8080/api in code.
VITE_API_BASE_URL=http://localhost:8080/api

# MySQL (only change if using external database)
# DB_URL=jdbc:mysql://db:3306/fyp_supervision
# DB_USER=fyp_user
# DB_PASS=fyp_pass
